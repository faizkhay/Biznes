{
  "name": "biznes",
  "version": "0.1.0",
  "private": true,
  "description": "biznes.mu: the search engine for business in Mauritius, built by Khay Digital.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "crawl": "node crawler/run.mjs",
    "screenshots": "node scripts/screenshots.mjs && node scripts/shrink-screens.mjs",
    "a11y": "node scripts/a11y.mjs",
    "behaviour": "node scripts/behaviour.mjs",
    "copy": "node scripts/check-copy.mjs src crawler content README.md PRODUCT.md STORY.md DESIGN.md REVENUE.md",
    "tokens": "node scripts/check-tokens.mjs",
    "contrast": "node scripts/contrast.mjs --json scripts/contrast.pairs.json",
    "design": "npx --yes @google/design.md@0.4.0 lint DESIGN.md",
    "og": "node scripts/og.mjs",
    "leads": "node scripts/leads.mjs",
    "pdf": "node scripts/pdf.mjs",
    "hero": "node scripts/hero-contrast.mjs",
    "picture": "node scripts/picture.mjs",
    "seo": "node scripts/seo.mjs",
    "weights": "node scripts/weights.mjs",
    "test:rls": "bash scripts/test-rls.sh",
    "behaviour:tax": "node scripts/behaviour-tax.mjs",
    "behaviour:baz": "node scripts/behaviour-baz.mjs",
    "glass": "node scripts/glass-contrast.mjs",
    "icons:sheet": "node scripts/icon-sheet.mjs",
    "icons:districts": "node scripts/district-icons.mjs",
    "search:test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/search-test.mjs",
    "search:measure": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-paths.mjs scripts/search-measure.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "osm-pbf-parser-node": "^1.1.4",
    "playwright": "1.56.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
