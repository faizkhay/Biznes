{
  "name": "biznes",
  "version": "0.1.0",
  "private": true,
  "description": "biznes.mu: ready-to-launch businesses in Mauritius, built by Khay Digital.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "wordmarks": "node scripts/make-wordmarks.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "a11y": "node scripts/a11y.mjs",
    "reveals": "node scripts/reveal-check.mjs",
    "copy": "node scripts/check-copy.mjs",
    "tokens": "node scripts/check-tokens.mjs",
    "contrast": "node scripts/contrast.mjs --json scripts/contrast.pairs.json",
    "design": "node scripts/check-design.mjs && npx --yes @google/design.md@0.4.0 lint DESIGN.md",
    "behaviour": "node scripts/behaviour.mjs",
    "stills": "node scripts/stills.mjs",
    "plates": "node scripts/prepare-plates.mjs"
  },
  "dependencies": {
    "geist": "^1.5.1",
    "lenis": "^1.3.0",
    "next": "16.3.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/fredoka": "^5.2.0",
    "@fontsource/jost": "^5.2.0",
    "@fontsource/outfit": "^5.2.0",
    "@fontsource/playfair-display": "^5.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "opentype.js": "^1.3.4",
    "playwright": "1.56.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
