# Captures are made again by `npm run screenshots`. Six kinds of page are kept as the record of how
# the site looked when it was checked; the rest, and the viewport slices, are working files.
review/screens/*
!review/screens/home-*.jpg
!review/screens/landing-desktop.jpg
!review/screens/landing-mobile.jpg
!review/screens/landing-leaves-*.jpg
!review/screens/search-desktop.jpg
!review/screens/search-mobile.jpg
!review/screens/listing-desktop.jpg
!review/screens/listing-mobile.jpg
!review/screens/category-desktop.jpg
!review/screens/category-mobile.jpg
!review/screens/guide-desktop.jpg
!review/screens/guide-mobile.jpg
!review/screens/tool-vat-*.jpg
!review/screens/baz-manzer-*.jpg

# The icon sheet is made again by `npm run icons:sheet`. Its two pictures are kept as the record of
# the set; a large view or a slice written beside them is a working file.
review/icons/*
!review/icons/sheet-*.jpg

# Helpers for one session's checks.
scripts/_*

# What the crawler fetched: downloads and pages, kept between runs.
.crawl/

# The design skill's working files: mock-ups and its build record. Not part of the site.
.impeccable/

# Lists made for the owner from the index (npm run leads). Not part of the site.
reports/

# Previews sent to the owner during a round. Not part of the site.
review/preview/

# The local test stack for the accounts (scripts/accounts-stack.sh): its mail and its logs.
.accounts-stack/
